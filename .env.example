# Connectify Environment Variables

# JWT Secret for authentication tokens (REQUIRED for production)
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this"

# OpenRouter API Key for AI features (optional)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-REPLACE_WITH_YOUR_KEY"

# Application URL (used for CORS and self-referential links)
APP_URL="http://localhost:3000"

# Port for the Express server (default: 3000)
PORT=3000

# For Vercel/static deployments, set this to your backend API URL
# VITE_API_URL="https://your-backend-url.run.app"